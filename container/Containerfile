# Imagen única con todo el pipeline de mapa-casa:
#   - COLMAP (reconstrucción 3D) compilado con CUDA para RTX 50xx (sm_120)
#   - gsplat (Gaussian Splatting, el modelo 3D "tipo Street View")
#   - Open3D / ezdxf / shapely (generar el plano 2D)
# Todo software libre; CUDA/driver NVIDIA son los únicos componentes propietarios.
# Se usa OpenBLAS en lugar de Intel MKL (MKL es propietario).

ARG CUDA_VERSION=12.9.1
FROM docker.io/nvidia/cuda:${CUDA_VERSION}-devel-ubuntu24.04

ARG COLMAP_VERSION=4.2.1
ARG GSPLAT_VERSION=v1.5.3
ARG CUDA_ARCH=120
ENV DEBIAN_FRONTEND=noninteractive \
    QT_XCB_GL_INTEGRATION=xcb_egl \
    TORCH_CUDA_ARCH_LIST="12.0" \
    MAX_JOBS=8

# ---------- Dependencias del sistema ----------
RUN apt-get update && apt-get install -y --no-install-recommends \
        git cmake ninja-build build-essential ca-certificates curl ffmpeg \
        libboost-program-options-dev libboost-graph-dev libboost-system-dev \
        libeigen3-dev libopenimageio-dev openimageio-tools libmetis-dev \
        libgoogle-glog-dev libgtest-dev libgmock-dev libsqlite3-dev libglew-dev \
        qt6-base-dev libqt6opengl6-dev libqt6openglwidgets6 qt6-svg-dev \
        libcgal-dev libceres-dev libcurl4-openssl-dev libssl-dev \
        libopenblas-dev liblapack-dev \
        python3 python3-dev python3-venv \
        libgl1 libegl1 libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /usr/include/opencv4

# ---------- COLMAP ----------
RUN git clone --depth 1 --branch ${COLMAP_VERSION} https://github.com/colmap/colmap.git /src/colmap \
    && cmake -S /src/colmap -B /src/colmap/build -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCH} \
        -DBLA_VENDOR=OpenBLAS \
        -DONNX_ENABLED=OFF \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
    && cmake --build /src/colmap/build --target install \
    && rm -rf /src/colmap/build

# ---------- Python: PyTorch + gsplat + herramientas de plano ----------
RUN python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
RUN pip install --no-cache-dir --upgrade pip wheel setuptools ninja \
    && pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cu128

RUN git clone --depth 1 --branch ${GSPLAT_VERSION} --recursive https://github.com/nerfstudio-project/gsplat.git /opt/gsplat \
    && pip install --no-cache-dir --no-build-isolation /opt/gsplat \
    && pip install --no-cache-dir --no-build-isolation -r /opt/gsplat/examples/requirements.txt

RUN pip install --no-cache-dir open3d ezdxf shapely scipy trimesh

WORKDIR /work
CMD ["bash"]

# fused-ssim y fused-bilagrid detectan la GPU al compilar; en `podman build` no hay GPU
# y usan una lista fija sin sm_120 (RTX 50xx). Se recompilan forzando la arquitectura.
RUN for repo in rahul-goel/fused-ssim@328dc9836f513d00c4b5bc38fe30478b4435cbb5 \
                harry7557558/fused-bilagrid@90f9788e57d3545e3a033c1038bb9986549632fe; do \
        name=${repo%@*}; sha=${repo#*@}; dir=/src/$(basename $name); \
        git clone https://github.com/$name.git $dir && git -C $dir checkout $sha && \
        sed -i 's/"-gencode=arch=compute_89,code=sm_89",/"-gencode=arch=compute_89,code=sm_89", "-gencode=arch=compute_120,code=sm_120",/' $dir/setup.py && \
        grep -q compute_120 $dir/setup.py && \
        pip install --no-cache-dir --no-build-isolation --force-reinstall --no-deps $dir || exit 1; \
    done
